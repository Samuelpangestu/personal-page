{
  "name": "personal-page",
  "compatibility_date": "2026-09-28",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/weddingsamuelledy", "/weddingsamuelledy/", "/weddingsamuelledy/index.html", "/weddingsamuelledy/invitation", "/weddingsamuelledy/invitation/", "/weddingsamuelledy/api/rsvp"],
    "html_handling": "none"
  },
  // samuelpgt.com belongs to this Worker only. The custom domain keeps the DNS
  // record; the routes mirror the ones set in the dashboard, because wrangler
  // replaces this Worker's routes with this list on every deploy.
  "workers_dev": true,
  "routes": [
    { "pattern": "samuelpgt.com", "custom_domain": true },
    { "pattern": "samuelpgt.com/*", "zone_name": "samuelpgt.com" },
    { "pattern": "samuelpgt.com/profile*", "zone_name": "samuelpgt.com" },
    { "pattern": "samuelpgt.com/weddingsamuelledy*", "zone_name": "samuelpgt.com" }
  ]
}
